{
  "expo": {
    "name": "Badgram",
    "slug": "badgram",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.badgram.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "اجازه دسترسی به میکروفون برای ضبط پیام صوتی در بادگرام",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
